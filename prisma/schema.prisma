generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String            @id @default(uuid())
  role         String
  registryId   String            @unique
  passwordHash String
  name         String
  baranggay    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  isBanned     Boolean           @default(false)
  assets       Asset[]           @relation("ProviderAssets")
  requests     DispatchRequest[] @relation("FarmerRequests")
  announcements Announcement[]
}

model Announcement {
  id          String   @id @default(uuid())
  title       String
  content     String
  baranggay   String
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Asset {
  id          String            @id @default(uuid())
  providerId  String
  type        String
  name        String
  description String
  rate        Float
  unit        String
  status      String            @default("available")
  location    String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  provider    User              @relation("ProviderAssets", fields: [providerId], references: [id])
  requests    DispatchRequest[]
}

model DispatchRequest {
  id        String   @id @default(uuid())
  farmerId  String
  assetId   String
  status    String   @default("pending")
  date      DateTime
  hectares  Float?
  totalCost Float?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  asset     Asset    @relation(fields: [assetId], references: [id])
  farmer    User     @relation("FarmerRequests", fields: [farmerId], references: [id])
}

model SiemLog {
  id         String   @id @default(uuid())
  eventType  String
  ipAddress  String?
  registryId String?
  details    String?
  severity   String   @default("LOW")
  createdAt  DateTime @default(now())
}

model IpBlacklist {
  id        String   @id @default(uuid())
  ipAddress String   @unique
  reason    String?
  createdAt DateTime @default(now())
}

model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model TrafficLog {
  id        String   @id @default(uuid())
  ipAddress String
  userAgent String?
  path      String?
  timestamp DateTime @default(now())
}
